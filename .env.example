# Kopie als .env.local anlegen und ausfüllen. .env.local wird nie committet.
#
# ── Supabase ────────────────────────────────────────────────────────────────
# Projekt in eu-central-1 (Frankfurt). Die Region ist kein Zufall: sie muss zur
# Vercel-Function-Region (fra1) passen, sonst kostet jeder Query rund 150 ms —
# und sie ist es, die die EU-Aussage im Datenfluss-Panel tragfähig macht.
#
# Supabase hat die API-Keys umgestellt. Wir nutzen das aktuelle Schema
# (sb_publishable_ / sb_secret_), nicht die Legacy-JWTs anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" im Dashboard. Läuft im Browser und ist genau so sicher wie
# die RLS-Policies — er ist kein Geheimnis, sondern eine Adresse.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" im Dashboard. Umgeht RLS vollständig. Ausschließlich im
# Ingestion-Worker verwenden, nie in einer Route, die direkt auf eine
# Nutzeraktion antwortet — ein Unit-Test prüft den Import-Graph darauf.
# Niemals mit NEXT_PUBLIC_ präfixen: das würde ihn ins Browser-Bundle backen.
SUPABASE_SECRET_KEY=

# ── AI-Anbieter ─────────────────────────────────────────────────────────────
# Google AI Studio — Chat (Standard) und die Sprachausgabe des Audio-Überblicks.
GOOGLE_GENERATIVE_AI_API_KEY=

# Mistral — Embeddings (fest, EU) und Chat als umschaltbare Alternative.
MISTRAL_API_KEY=

# Die Modell-IDs stehen hier und nicht im Code, und das ist nachgemessen statt
# vorsichtshalber: `gemini-2.5-flash` — das Modell, das ursprünglich vorgesehen
# war — antwortet einem frisch erzeugten Schlüssel mit
# `404 no longer available to new users`, obwohl es in der Modellliste steht.
# Ein Modell kann also verschwinden, ohne dass sich am Code etwas ändert. Ein
# fest verdrahteter String wäre ein Deploy, eine Variable ist ein Neustart.
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Der EU-Weg. Chat ist umschaltbar, Embeddings sind es nicht — ein Vektorraum
# lässt sich nicht mischen, ein Wechsel hieße Re-Ingest aller Quellen.
#
# `mistral-small-latest` und `mistral-medium-latest` wären die naheliegende
# Wahl und scheitern: sie antworten mit 429 und dem Header
# `x-ratelimit-limit-req-minute: 0` — das Limit ist null, nicht erschöpft.
# Auf dem kostenlosen Tarif sind sie schlicht nicht enthalten, während
# Embeddings mit demselben Schlüssel 60/min bekommen. Nachgemessen.
#
# `open-mistral-nemo` liegt bei 188/min und hält im Test die Belegdisziplin
# am saubersten ein: es erkennt, wenn ein vorgelegter Ausschnitt die Frage
# nicht beantwortet, statt eine Begründung zu erfinden.
MISTRAL_CHAT_MODEL=open-mistral-nemo
# Sprachausgabe des Audio-Überblicks. Alle TTS-Modelle sind Preview-Versionen.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
