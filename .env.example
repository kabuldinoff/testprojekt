# Kopie als .env.local anlegen und ausfüllen. .env.local wird nie committet.
#
# Supabase — Projekt in eu-central-1. Die Region ist kein Zufall: sie muss zur
# Vercel-Function-Region (fra1) passen, sonst kostet jeder Query rund 150 ms.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Umgeht RLS. Ausschließlich im Ingestion-Worker verwenden, nie in einer Route,
# die direkt auf eine Nutzeraktion antwortet. Ein Unit-Test prüft das.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio — Chat (Standard) und die Sprachausgabe des Audio-Überblicks.
GOOGLE_GENERATIVE_AI_API_KEY=

# Mistral — Embeddings (fest, EU) und Chat als umschaltbare Alternative.
MISTRAL_API_KEY=

# Die TTS-Modelle sind samt und sonders Preview-Versionen und können
# zurückgezogen werden. Deshalb konfigurierbar statt im Code.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
